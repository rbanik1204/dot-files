{
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 40,
    "modules-left": [
        "wlr/taskbar",
        "custom/nvidia",
        "custom/amd-gpu",
        "custom/fan",
        "custom/power-profile",
        "custom/system-overview",
        "custom/vpn"
        // "hyprland/window#bottom"
    ],
    "modules-center": [
        "custom/spotify",
        "custom/visualizer"
    ],
    "modules-right": [
        "custom/updates",
        "custom/weather",
        "temperature",
        "backlight",
        "custom/disk"
    ],
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "icon-theme": "Papirus-Dark",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-right": "close",
        "on-click-middle": "close",
        "sort-by-app-id": true
    },
    "hyprland/window#bottom": {
        "format": " {title}",
        "empty-output-format": "",
        "separate-outputs": true,
        "max-length": 50,
        "rewrite": {
            "(.*) — Mozilla Firefox": "  $1",
            "(.*) - VSCodium": "󰨞 $1",
            "(.*) - Visual Studio Code": "󰨞 $1",
            "(.*)Thunar(.*)": "󰝰 Files",
            "(.*)Spotify(.*)": "󰓇 Spotify"
        }
    },
    "custom/visualizer": {
        "exec": "~/.config/waybar/scripts/visualizer.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": false,
        "min-length": 10,
        "max-length": 20
    },
    "custom/spotify": {
        "exec": "~/.config/waybar/scripts/music.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "playerctl play-pause || spotify",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "tooltip": true
    },
    "custom/weather": {
        "exec": "curl -sf --max-time 3 'https://wttr.in/?format=%t+%C' 2>/dev/null | awk '{print \"󰖩 \" $0}' || echo '󰖩 --'",
        "interval": 1800,
        "tooltip": true,
        "tooltip-format": "Weather data from wttr.in"
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 80,
        "interval": 5,
        "format": "󰏈 {temperatureC}°C",
        "format-critical": "󰔏 {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "CPU Temperature: {temperatureC}°C"
    },
    "backlight": {
        "interval": 2,
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "tooltip-format": "Brightness: {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "smooth-scrolling-threshold": 1,
        "min-length": 0
    },
    "custom/disk": {
        "exec": "~/.config/waybar/scripts/disk.sh",
        "return-type": "json",
        "interval": 30,
        "on-click": "~/.config/waybar/scripts/disk.sh click && pkill -RTMIN+8 waybar",
        "signal": 8,
        "format": "{}"
    },
    "custom/nvidia": {
        "exec": "~/.config/waybar/scripts/system-monitor/modules/nvidia_module.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "escape": false
    },
    "custom/amd-gpu": {
        "exec": "~/.config/waybar/scripts/system-monitor/modules/amd_gpu_module.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "escape": false
    },
    "custom/power-profile": {
        "exec": "~/.config/waybar/scripts/system-monitor/modules/power_profile_module.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "escape": false,
        "on-click": "~/.config/waybar/scripts/system-monitor/modules/power_profile_module.py cycle"
    },
    "custom/fan": {
        "exec": "~/.config/waybar/scripts/system-monitor/modules/fan_module.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "escape": false
    },
    "custom/updates": {
        "exec": "~/.config/waybar/scripts/system-monitor/modules/updates_module.py",
        "return-type": "json",
        "interval": 60,
        "tooltip": true,
        "escape": false,
        "on-click": "~/.config/waybar/scripts/system-monitor/scripts_helpers/open-update-terminal.sh"
    },
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/system-monitor/modules/vpn_module.py",
        "return-type": "json",
        "interval": 5,
        "tooltip": true,
        "escape": false
    },
    "custom/system-overview": {
        "exec": "~/.config/waybar/scripts/system-monitor/modules/system_overview_module.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "escape": false,
        "on-click": "~/.config/waybar/scripts/system-monitor/modules/system_overview_module.py show"
    }
}